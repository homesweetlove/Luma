<Window
    x:Class="Luma.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Luma">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{StaticResource LumaBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Width="36" Height="34" Click="BackButton_Click" ToolTipService.ToolTip="Back">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="1" Width="36" Height="34" Click="ForwardButton_Click" ToolTipService.ToolTip="Forward">
                    <SymbolIcon Symbol="Forward" />
                </Button>
                <Button x:Name="ReloadButton" Grid.Column="2" Width="36" Height="34" Click="ReloadButton_Click" ToolTipService.ToolTip="Reload">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button x:Name="HomeButton" Grid.Column="3" Width="36" Height="34" Click="HomeButton_Click" ToolTipService.ToolTip="Home">
                    <SymbolIcon Symbol="Home" />
                </Button>

                <Border
                    Grid.Column="4"
                    Height="36"
                    CornerRadius="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{StaticResource LumaBorderBrush}"
                    BorderThickness="1">
                    <TextBox
                        x:Name="AddressBox"
                        BorderThickness="0"
                        Background="Transparent"
                        PlaceholderText="Search or enter website"
                        VerticalContentAlignment="Center"
                        KeyDown="AddressBox_KeyDown" />
                </Border>

                <Button x:Name="GoButton" Grid.Column="5" Height="34" Padding="12,0" Click="GoButton_Click" Content="Go" />
                <Button x:Name="SnapshotButton" Grid.Column="6" Height="34" Padding="12,0" Click="SnapshotButton_Click" Content="Snapshot" />
                <Button x:Name="AgentToggleButton" Grid.Column="7" Width="38" Height="34" Click="AgentToggleButton_Click" ToolTipService.ToolTip="Toggle Luma Agent">
                    <SymbolIcon Symbol="Message" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AgentColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <TabView
                x:Name="BrowserTabs"
                Grid.Column="0"
                IsAddTabButtonVisible="True"
                AddTabButtonClick="BrowserTabs_AddTabButtonClick"
                TabCloseRequested="BrowserTabs_TabCloseRequested"
                SelectionChanged="BrowserTabs_SelectionChanged" />

            <Border
                x:Name="AgentPanel"
                Grid.Column="1"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{StaticResource LumaBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Luma Agent" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Free-first · foreground-aware · local-first" Opacity="0.65" FontSize="12" />
                        <TextBlock x:Name="AgentStatusText" Text="Ready" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RecordMacroButton" Grid.Column="0" Click="RecordMacroButton_Click" Content="● Record" />
                        <Button x:Name="ReplayMacroButton" Grid.Column="1" Click="ReplayMacroButton_Click" Content="Replay" />
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock Text="Foreground Watch" FontWeight="SemiBold" />
                        <TextBox x:Name="WatchTextBox" PlaceholderText="Text to watch for, e.g. 19:00" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="WatchToggleButton" Grid.Column="0" Click="WatchToggleButton_Click" Content="Start watching" />
                            <CheckBox x:Name="AutoClickCheckBox" Grid.Column="1" Content="Auto-click" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Runs only while Luma is active and this tab is selected." FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock Text="Recorded steps" FontWeight="SemiBold" />
                        <TextBlock x:Name="MacroSummaryText" Text="No macro recorded" FontSize="12" Opacity="0.65" />
                    </StackPanel>

                    <ListView x:Name="MacroStepsList" Grid.Row="4" SelectionMode="None" />

                    <Grid Grid.Row="5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="CommandBox"
                            Grid.Column="0"
                            PlaceholderText="Ask Luma…"
                            AcceptsReturn="False"
                            KeyDown="CommandBox_KeyDown" />
                        <Button x:Name="SendCommandButton" Grid.Column="1" Click="SendCommandButton_Click" Content="Send" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
