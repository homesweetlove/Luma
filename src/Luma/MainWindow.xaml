<Window
    x:Class="Luma.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Luma">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusAddress_Invoked" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTab_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTab_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Reload_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="10,6" Background="{ThemeResource LumaPanelBrush}"
                BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BackButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="BackButton_Click" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="ForwardButton_Click" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward">
                        <SymbolIcon Symbol="Forward" />
                    </Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="ReloadButton_Click" ToolTipService.ToolTip="Reload (F5)" AutomationProperties.Name="Reload">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button x:Name="HomeButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="HomeButton_Click" ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
                        <SymbolIcon Symbol="Home" />
                    </Button>
                </StackPanel>
                <TextBox x:Name="AddressBox" Grid.Column="1" MinHeight="32" Padding="12,4"
                         CornerRadius="8" VerticalContentAlignment="Center"
                         PlaceholderText="Search or enter website" AutomationProperties.Name="Search or enter website"
                         ToolTipService.ToolTip="Search or enter website (Ctrl+L)" KeyDown="AddressBox_KeyDown" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="GoButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="GoButton_Click" ToolTipService.ToolTip="Go" AutomationProperties.Name="Go">
                        <SymbolIcon Symbol="Go" />
                    </Button>
                    <Button x:Name="SnapshotButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="SnapshotButton_Click" ToolTipService.ToolTip="Capture page snapshot" AutomationProperties.Name="Capture page snapshot">
                        <SymbolIcon Symbol="Camera" />
                    </Button>
                    <Button x:Name="AgentToggleButton" Style="{StaticResource LumaToolbarButtonStyle}"
                            Click="AgentToggleButton_Click" ToolTipService.ToolTip="Toggle Luma Agent" AutomationProperties.Name="Toggle Luma Agent">
                        <SymbolIcon Symbol="Message" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar x:Name="NavigationProgress" Grid.Row="1" Height="2" IsIndeterminate="True"
                     Visibility="Collapsed" Foreground="{ThemeResource LumaAccentBrush}"
                     AutomationProperties.Name="Page loading" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AgentColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TabView x:Name="BrowserTabs" TabWidthMode="Compact"
                     IsAddTabButtonVisible="True" AutomationProperties.Name="Browser tabs"
                     AddTabButtonClick="BrowserTabs_AddTabButtonClick"
                     TabCloseRequested="BrowserTabs_TabCloseRequested"
                     SelectionChanged="BrowserTabs_SelectionChanged" />

            <Border x:Name="AgentPanel" Grid.Column="1" Visibility="Collapsed"
                    Background="{ThemeResource LumaPanelBrush}"
                    BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Padding="14" Spacing="16">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Luma Agent" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Local tools · foreground watch" FontSize="12"
                                           Foreground="{ThemeResource LumaSecondaryTextBrush}" />
                            </StackPanel>
                            <Button x:Name="VaultButton" Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource LumaToolbarButtonStyle}" Click="VaultButton_Click"
                                    ToolTipService.ToolTip="Open secure vault" AutomationProperties.Name="Open secure vault">
                                <SymbolIcon Symbol="Permissions" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="AgentStatusText" Text="Ready" Style="{StaticResource LumaStatusTextStyle}" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="DELEGATE" Style="{StaticResource LumaSectionHeaderStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DelegateGeminiButton" Content="Gemini" HorizontalAlignment="Stretch"
                                        Style="{StaticResource LumaToolButtonStyle}" Click="DelegateGeminiButton_Click"
                                        ToolTipService.ToolTip="Delegate to Gemini" AutomationProperties.Name="Delegate to Gemini" />
                                <Button x:Name="DelegateClaudeButton" Grid.Column="1" Content="Claude" HorizontalAlignment="Stretch"
                                        Style="{StaticResource LumaToolButtonStyle}" Click="DelegateClaudeButton_Click"
                                        ToolTipService.ToolTip="Delegate to Claude" AutomationProperties.Name="Delegate to Claude" />
                            </Grid>
                            <Button x:Name="ReadDelegateButton" Content="Read selected reply" HorizontalAlignment="Stretch"
                                    Style="{StaticResource LumaToolButtonStyle}" Click="ReadDelegateButton_Click"
                                    ToolTipService.ToolTip="Read the selected delegate reply" AutomationProperties.Name="Read selected reply" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="MACROS" Style="{StaticResource LumaSectionHeaderStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RecordMacroButton" Content="● Record" Click="RecordMacroButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button x:Name="ReplayMacroButton" Grid.Column="1" Content="Replay" Click="ReplayMacroButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ImportMacroButton" Content="Import" Click="ImportMacroButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button x:Name="ExportMacroButton" Grid.Column="1" Content="Export" Click="ExportMacroButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Saved macros" Click="MacroLibraryButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button Content="Visual editor" Grid.Column="1" Click="OpenMacroEditorButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock x:Name="MacroSummaryText" Text="No macro recorded" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource LumaSecondaryTextBrush}" />
                            <ListView x:Name="MacroStepsList" MaxHeight="160" SelectionMode="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Recorded macro steps" />
                            <Expander x:Name="MacroEditorExpander" Header="Visual step editor" IsExpanded="False">
                                <StackPanel Spacing="8" Padding="0,8,0,8">
                                    <TextBlock Text="Edit a working copy. Apply validates the whole program before replacing the current macro."
                                               TextWrapping="Wrap" FontSize="12" />
                                    <ListView x:Name="EditorStepsList" MaxHeight="190" MinHeight="100"
                                              SelectionChanged="EditorStepsList_SelectionChanged"
                                              AutomationProperties.Name="Nested macro steps" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="+ Root" Click="EditorAddRoot_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="+ Child" Click="EditorAddChild_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="2" Content="+ Else" Click="EditorAddElse_Click" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="↑ Up" Click="EditorMoveUp_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="↓ Down" Click="EditorMoveDown_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="2" Content="Remove" Click="EditorRemove_Click" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <ComboBox x:Name="EditorKindBox" Header="Selected step type" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="navigate" /><ComboBoxItem Content="click" />
                                        <ComboBoxItem Content="input" /><ComboBoxItem Content="wait" />
                                        <ComboBoxItem Content="retry" /><ComboBoxItem Content="if" />
                                        <ComboBoxItem Content="loop" />
                                    </ComboBox>
                                    <TextBox x:Name="EditorSelectorBox" Header="CSS selector (click / input / wait / if)" />
                                    <TextBox x:Name="EditorUrlBox" Header="URL (navigate)" />
                                    <PasswordBox x:Name="EditorValueBox" Header="Input value (session only · not saved in library)" />
                                    <ComboBox x:Name="EditorConditionBox" Header="Condition (wait / if)" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="ready" /><ComboBoxItem Content="exists" />
                                        <ComboBoxItem Content="absent" /><ComboBoxItem Content="visible" />
                                        <ComboBoxItem Content="enabled" />
                                    </ComboBox>
                                    <NumberBox x:Name="EditorLoopBox" Header="Loop count" Minimum="1" Maximum="100" Value="1" />
                                    <NumberBox x:Name="EditorRetryBox" Header="Retry attempts" Minimum="0" Maximum="10" Value="0" />
                                    <NumberBox x:Name="EditorTimeoutBox" Header="Timeout (ms)" Minimum="1" Maximum="30000" Value="5000" />
                                    <TextBlock x:Name="EditorMessageText" Text="Choose a step to edit. Input values cannot be saved as plaintext."
                                               TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Update selected step" Click="EditorUpdate_Click" HorizontalAlignment="Stretch" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Content="Discard" Click="EditorDiscard_Click" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="Apply macro" Click="EditorApply_Click"
                                                HorizontalAlignment="Stretch" Style="{StaticResource LumaToolButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="AI MACRO PLAN" Style="{StaticResource LumaSectionHeaderStyle}" />
                            <TextBlock Text="Ask Claude or Gemini for a JSON plan. Select its reply, review, then load it; nothing runs automatically."
                                       TextWrapping="Wrap" FontSize="12" />
                            <TextBox x:Name="AiPlanTaskBox" Header="Describe the steps to automate" MaxLength="2000"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78"
                                     PlaceholderText="Example: open example.com, wait for #ready, then click #continue" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="Plan with Gemini" Click="PlanGemini_Click"
                                        HorizontalAlignment="Stretch" Style="{StaticResource LumaToolButtonStyle}" />
                                <Button Grid.Column="1" Content="Plan with Claude" Click="PlanClaude_Click"
                                        HorizontalAlignment="Stretch" Style="{StaticResource LumaToolButtonStyle}" />
                            </Grid>
                            <Button Content="Review selected AI plan" Click="ReviewAiPlan_Click"
                                    HorizontalAlignment="Stretch" Style="{StaticResource LumaToolButtonStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="FOREGROUND WATCH" Style="{StaticResource LumaSectionHeaderStyle}" />
                            <TextBox x:Name="WatchTextBox" PlaceholderText="Text to watch for, e.g. 19:00"
                                     AutomationProperties.Name="Text to watch for" />
                            <ToggleButton x:Name="WatchToggleButton" Click="WatchToggleButton_Click" Content="Start watching"
                                          HorizontalAlignment="Stretch" MinHeight="32" />
                            <CheckBox x:Name="AutoClickCheckBox" Content="Auto-click when found" />
                            <TextBox x:Name="WatchStartBox" Header="Start (ISO datetime)"
                                     PlaceholderText="2026-10-12T19:00:00+09:00" AutomationProperties.Name="Watch start ISO datetime" />
                            <TextBox x:Name="WatchEndBox" Header="End (ISO datetime)"
                                     PlaceholderText="2026-10-12T20:00:00+09:00" AutomationProperties.Name="Watch end ISO datetime" />
                            <CheckBox x:Name="ReplayAfterWatchCheckBox" Content="Replay macro when found" />
                            <Button x:Name="WatchScheduleButton" Content="Schedule watch" Click="WatchScheduleButton_Click"
                                    Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Runs while Luma is active and this tab is selected." FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource LumaSecondaryTextBrush}" />
                            <Button x:Name="CancelAutomationButton" Content="Cancel automation" Click="CancelAutomationButton_Click"
                                    Style="{StaticResource LumaToolButtonStyle}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="ASK LUMA" Style="{StaticResource LumaSectionHeaderStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandBox" PlaceholderText="Ask Luma…" AcceptsReturn="False"
                                         KeyDown="CommandBox_KeyDown" AutomationProperties.Name="Ask Luma" />
                                <Button x:Name="SendCommandButton" Grid.Column="1" Content="Send" Click="SendCommandButton_Click"
                                        Style="{StaticResource LumaToolButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="12,5" Background="{ThemeResource LumaPanelBrush}"
                BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="ForegroundStatusText" Text="Ready" Style="{StaticResource LumaStatusTextStyle}" />
        </Border>
    </Grid>
</Window>
