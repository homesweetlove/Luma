<Application
    x:Class="Luma.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LumaPanelBrush" Color="#F2F8F8FA" />
                    <SolidColorBrush x:Key="LumaBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="LumaAccentBrush" Color="#6878F5" />
                    <SolidColorBrush x:Key="LumaSecondaryTextBrush" Color="#65666F" />
                    <SolidColorBrush x:Key="LumaGlassBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="LumaGlassBorderBrush" Color="#80FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LumaPanelBrush" Color="#E8212228" />
                    <SolidColorBrush x:Key="LumaBorderBrush" Color="#32FFFFFF" />
                    <SolidColorBrush x:Key="LumaAccentBrush" Color="#9CA7FF" />
                    <SolidColorBrush x:Key="LumaSecondaryTextBrush" Color="#BFC1CA" />
                    <SolidColorBrush x:Key="LumaGlassBrush" Color="#A81D1F26" />
                    <SolidColorBrush x:Key="LumaGlassBorderBrush" Color="#24FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LumaPanelBrush" Color="#E8212228" />
                    <SolidColorBrush x:Key="LumaBorderBrush" Color="#32FFFFFF" />
                    <SolidColorBrush x:Key="LumaAccentBrush" Color="#9CA7FF" />
                    <SolidColorBrush x:Key="LumaSecondaryTextBrush" Color="#BFC1CA" />
                    <SolidColorBrush x:Key="LumaGlassBrush" Color="#A81D1F26" />
                    <SolidColorBrush x:Key="LumaGlassBorderBrush" Color="#24FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LumaPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LumaSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaGlassBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="LumaToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="LumaToolButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="LumaSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="LumaStatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
